{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; \"$CLAUDE_PROJECT_DIR/.claude/validate-record.sh\" \"$f\"; } 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Checking record frontmatter..."
          }
        ]
      }
    ]
  }
}
